# Secrets & lokale Daten — niemals committen
.env
data/
service-account*.json

# Release-Binary (~80MB) — nicht ins Repo, separat aufs VPS bringen (scp)
# oder per RIFF_DOWNLOAD_URL auf eine externe Ablage zeigen.
public/downloads/*.zip
public/downloads/*.exe

# Desktop-App (app/) — 2026-08 aus riff-app hierher gemergt, ein Repo statt
# zwei. Eigene lokale Zustandsdateien, analog zu oben.
app/node_modules/
app/dist/
app/config.json
app/data.json
app/*.log
app/helper/RiffHelperMac
app/helper/RiffHelperMac-*
