# ═══════════════════════════════════════════════════════════════════
# Riff Platform — Konfiguration
# Kopieren nach .env und ausfüllen. Die echte .env NIEMALS committen.
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Hinter nginx/Traefik (Hostinger): true — dann wird X-Forwarded-For
# fürs Rate-Limiting genutzt und HSTS gesetzt. Ohne Proxy: false!
TRUST_PROXY=true

# ── Google Sheets (2 Sheets à 50 Codes) ─────────────────────────────
# Service-Account-JSON als Base64 (empfohlen, ein Wert statt zwei):
#   Linux/Mac:  base64 -w0 service-account.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# ODER alternativ einzeln (dann B64-Variante leer lassen):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private Key mit \n statt echten Zeilenumbrüchen:
GOOGLE_PRIVATE_KEY=

# Die beiden Sheet-IDs (aus der URL: docs.google.com/spreadsheets/d/<ID>/edit)
RIFF_SHEET_ID_1=
RIFF_SHEET_ID_2=
# Tab-Name in beiden Sheets (Spalten: A=Code, B=Status, C=Eingelöst am, D=Beleg-ID)
RIFF_SHEET_TAB=Codes
# Sync-Intervall Sheet -> lokale DB (Sekunden)
SYNC_INTERVAL_SECONDS=300

# ── n8n-Redeem (Alternative zu Google Sheets oben) ──────────────────
# Wenn gesetzt, läuft die Code-Prüfung über diesen n8n-Webhook statt über
# den lokalen Sheets-Sync oben (RIFF_SHEET_ID_1/2 werden dann ignoriert).
# Der n8n-Workflow prüft den Code direkt gegen ein Google Sheet und markiert
# ihn dort als eingelöst.
N8N_REDEEM_WEBHOOK_URL=

# ── Produkt: Riff ───────────────────────────────────────────────────
RIFF_TOTAL_SLOTS=100
# Ohne diesen Wert liefert die Plattform automatisch public/downloads/
# Riff-Setup.exe aus (siehe server/products.js). Für Produktion optional
# auf eine externe Ablage (GitHub Release, CDN) umleiten:
RIFF_DOWNLOAD_URL=

# ── Produkt: Riff Pro (App-interne Freischaltung) ───────────────────
# Nur nötig, wenn dieser Pool über Sheets laufen soll statt über
# server/seed-codes.local.js (siehe HOSTINGER_DEPLOY_PROMPT.md). Ist
# GOOGLE_SERVICE_ACCOUNT_* oben gesetzt, aber RIFF_PRO_SHEET_ID_1 hier
# NICHT, bleibt der riff-pro-Pool leer — lokaler Seed wird dann übersprungen.
RIFF_PRO_SHEET_ID_1=
RIFF_PRO_SHEET_TAB=Codes
RIFF_PRO_TOTAL_SLOTS=0

# ── Sicherheit ──────────────────────────────────────────────────────
# Optional: schaltet GET /api/admin/audit frei (Bearer-Token).
# Langes Zufallstoken verwenden, z. B.: openssl rand -hex 32
ADMIN_TOKEN=

# Rate-Limiting (Defaults sind sinnvoll, nur bei Bedarf ändern)
#RATE_WINDOW_MS=600000
#RATE_ATTEMPTS_PER_WINDOW=8
#RATE_GLOBAL_PER_MINUTE=120
