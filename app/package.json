{
  "name": "riff",
  "version": "0.2.0",
  "private": true,
  "description": "Riff",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/check.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "build:helper:mac": "swiftc -target x86_64-apple-macos11 helper/RiffHelperMac.swift -o helper/RiffHelperMac-x64 && swiftc -target arm64-apple-macos11 helper/RiffHelperMac.swift -o helper/RiffHelperMac-arm64 && lipo -create helper/RiffHelperMac-x64 helper/RiffHelperMac-arm64 -output helper/RiffHelperMac && rm helper/RiffHelperMac-x64 helper/RiffHelperMac-arm64 && chmod +x helper/RiffHelperMac"
  },
  "build": {
    "appId": "cloud.halovision.riff",
    "productName": "Riff",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "publish": null,
    "files": [
      "src/**/*",
      "helper/**/*",
      "scripts/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "identity": null,
      "x64ArchFiles": "Contents/Resources/app/helper/RiffHelperMac",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Riff hört nur zu, während du den Diktier-Shortcut hältst, und wandelt deine Sprache in Text um."
      }
    },
    "afterSign": "scripts/afterSign-mac.js",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Riff",
      "artifactName": "Riff-Setup.exe"
    },
    "portable": {
      "artifactName": "Riff-Portable.exe"
    },
    "copyright": "Copyright © 2026 Riff"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "author": "Riff"
}
